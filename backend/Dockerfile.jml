FROM eclipse-temurin:11-jdk as builder

WORKDIR /build

RUN apt-get update && apt-get install -y maven wget

COPY . /build/project

RUN cd /build/project/backend && mvn -B dependency:copy-dependencies -DoutputDirectory=/build/libs -DskipTests compile -q

RUN wget -q -O /build/openjml.jar https://github.com/OpenJML/OpenJML/releases/download/0.21.0/openjml-0.21.0.jar

RUN cd /build && java -jar /build/openjml.jar -classpath "/build/libs/*:/build/project/backend/target/classes" -sourcepath /build/project/backend/src/main/java -noInternalSpecs -progress /build/project/backend/src/main/java/it/greentrails/backend/utils/DistanceCalculator.java /build/project/backend/src/main/java/it/greentrails/backend/utils/service/ResponseGenerator.java /build/project/backend/src/main/java/it/greentrails/backend/gestioneattivita/service/AttivitaService.java /build/project/backend/src/main/java/it/greentrails/backend/gestioneattivita/service/CameraService.java /build/project/backend/src/main/java/it/greentrails/backend/gestioneattivita/service/RecensioneService.java /build/project/backend/src/main/java/it/greentrails/backend/gestionericerca/service/RicercaService.java /build/project/backend/src/main/java/it/greentrails/backend/gestioneutenze/service/GestioneUtenzeService.java /build/project/backend/src/main/java/it/greentrails/backend/gestioneprenotazioni/service/PrenotazioneAlloggioService.java > /build/verification-output.txt 2>&1; true

FROM alpine:latest
COPY --from=builder /build/verification-output.txt /verification-output.txt
CMD ["cat", "/verification-output.txt"]
