# ── Proxmox API ──────────────────────────────────────────────
# Required
PROXMOX_HOST=
PROXMOX_USER=root@pam
PROXMOX_TOKEN_ID=
PROXMOX_TOKEN_SECRET=

# Optional (defaults shown)
PROXMOX_NODE=pve
PROXMOX_VALIDATE_CERTS=no
PROXMOX_CA_PATH=
PROXMOX_SSH_USER=root
PROXMOX_CLOUDINIT_STORAGE=local-lvm
PROXMOX_IMPORT_STORAGE=local

# ── Networking ───────────────────────────────────────────────
# Optional (defaults shown)
GT_BENCHMARK_BRIDGE=vnet0
GT_BENCHMARK_GATEWAY=192.168.2.1

# ── Database ─────────────────────────────────────────────────
# Required
GT_DB_PASS=

# Optional (defaults shown)
GT_DB_NAME=greentrails
GT_DB_USER=greentrails

# ── AMBER ────────────────────────────────────────────────────
# Required
GT_AMBER_LXC_PASSWORD=
GT_VM_PASSWORD=

# Optional (defaults shown)
GT_AMBER_MODEL=oscnn

# ── Stale worker handling ────────────────────────────────────
# Optional: "fail" (default), "destroy", or "reuse"
GT_STALE_WORKER_POLICY=fail

# ── Build ────────────────────────────────────────────────────
# Optional: set to "yes" to force JAR rebuild even if artifacts exist
GT_FORCE_BUILD=no
